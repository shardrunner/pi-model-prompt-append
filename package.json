{
  "name": "pi-model-prompt-append",
  "version": "0.1.0",
  "description": "Append custom system-prompt guidelines for specific Pi models.",
  "license": "MIT",
  "author": "Michael Brunner",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
